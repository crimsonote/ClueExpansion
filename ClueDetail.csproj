<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
    <!-- 0.1.21 删除了回放时间线系统；回放代码用 #if TIMELINE 保留，-p:HasTimeline=true 可重新启用。 -->
    <HasTimeline Condition="'$(HasTimeline)' == ''">false</HasTimeline>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HasTimeline)' == 'true'">
    <DefineConstants>$(DefineConstants);TIMELINE</DefineConstants>
  </PropertyGroup>
<PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ClueDetail</AssemblyName>
    <Description>Deadly Trick - restore detailed clue activity records (0.1.18 removed the {what} segment)</Description>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0649</NoWarn>

    <!-- 游戏安装目录：换机器/换盘符时用 -p:GameDir=... 覆盖。 -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Deadly Trick</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>

    <!-- 默认直接取游戏安装目录里的 Managed —— 运行期实际加载的就是这一份。 -->
    <GameManaged Condition="'$(GameManaged)' == ''">$(GameDir)\DeadlyTrick_Data\Managed</GameManaged>
  </PropertyGroup>

  <!-- 刻意不用 NuGet：沙箱内 HTTPS 走不了 nuget.org，游戏自带的 BepInEx 5 已提供所需程序集。 -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SteamP2PSession.SendBytes 返回 Steamworks 的 EResult；即便忽略返回值，解析签名也要这个程序集。 -->
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameManaged)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Google.Protobuf">
      <HintPath>$(GameManaged)\Google.Protobuf.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(GameManaged)\UnityEngine.Physics2DModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
